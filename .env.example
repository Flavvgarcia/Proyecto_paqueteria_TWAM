# Copia este archivo como .env y llena tus valores. El .env NO se sube a Git;
# este .env.example SÍ (sin valores reales), para que otros sepan qué variables hay.

# Base de datos de pedidos. La contraseña es obligatoria: sin ella Compose no arranca.
POSTGRES_DB=pedidos
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=

# Clave de OpenRouteService (https://openrouteservice.org). Sin clave, rutas estima.
ORS_API_KEY=

# Coordenadas del almacén (opcional). Si se dejan vacías, se usa el TecNM Morelia.
ALMACEN_LAT=
ALMACEN_LNG=
